<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <Button
        android:id="@+id/btn_to_input_data"
        android:layout_width="116dp"
        android:layout_height="70dp"
        android:layout_marginTop="28dp"
        android:text="назад"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.121"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_to_input_work_dots"
        android:layout_width="129dp"
        android:layout_height="68dp"
        android:layout_marginStart="232dp"
        android:layout_marginBottom="8dp"
        android:text="далее"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <ScrollView
        android:layout_width="370dp"
        android:layout_height="480dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/textPsportDat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Вывод расчётов" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lNormalV"
                    android:layout_width="278dp"
                    android:layout_height="32dp"
                    android:text="Нормальный объём м3/ч" />

                <TextView
                    android:id="@+id/vNormalV"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lWorkV"
                    android:layout_width="278dp"
                    android:layout_height="32dp"
                    android:text="Рабочий объём м3/ч" />

                <TextView
                    android:id="@+id/vWorkV"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lTimeOfChange"
                    android:layout_width="278dp"
                    android:layout_height="32dp"
                    android:text="Время измерения при расходе газа 1 м3" />

                <TextView
                    android:id="@+id/vTimeOfChange"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lRashod"
                    android:layout_width="278dp"
                    android:layout_height="32dp"
                    android:text="Расход газа л/мин" />

                <TextView
                    android:id="@+id/vRashod"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lPowerOfGas"
                    android:layout_width="278dp"
                    android:layout_height="32dp"
                    android:text="Мощность горелки кВт" />

                <TextView
                    android:id="@+id/vPowerOfGas"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lKoef"
                    android:layout_width="278dp"
                    android:layout_height="32dp"
                    android:text="Коэффицент пересчёта" />

                <TextView
                    android:id="@+id/vKoef"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lPowerOfGasWithHeight"
                    android:layout_width="278dp"
                    android:layout_height="52dp"
                    android:text="Мощность горелки с учётом высоты над уровнем моря кВт" />

                <TextView
                    android:id="@+id/vPowerOfGasWithHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lProcentOfPower"
                    android:layout_width="278dp"
                    android:layout_height="32dp"
                    android:text="Процент влияния высоты на мощность %" />

                <TextView
                    android:id="@+id/vProcentOfPower"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lGazaBaro"
                    android:layout_width="278dp"
                    android:layout_height="32dp"
                    android:text="Расход газа л/мин" />

                <TextView
                    android:id="@+id/vGazaBaro"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lPowerOfGasPart"
                    android:layout_width="278dp"
                    android:layout_height="52dp"
                    android:text="Мощность горелки частичная нагрузка кВт" />

                <TextView
                    android:id="@+id/vPowerOfGasPart"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lPowerOfGasPartWithHeight"
                    android:layout_width="278dp"
                    android:layout_height="52dp"
                    android:text="Мощность горелки частичная нагрузка с учётом высоты над уровнем моря кВт" />

                <TextView
                    android:id="@+id/vPowerOfGasPartWithHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lWorkVPartPower"
                    android:layout_width="278dp"
                    android:layout_height="52dp"
                    android:text="Рабочий объем при частичной нагрузке м3/ч" />

                <TextView
                    android:id="@+id/vWorkVPartPower"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lTimeOfChangePartPower"
                    android:layout_width="278dp"
                    android:layout_height="52dp"
                    android:text="Время измерения при расходе газа 1 м3 при частичной нагрузке сек." />

                <TextView
                    android:id="@+id/vTimeOfChangePartPower"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lRashodPartPower"
                    android:layout_width="278dp"
                    android:layout_height="52dp"
                    android:text="Расход при частичной нагрузке л/мин" />

                <TextView
                    android:id="@+id/vRashodPartPower"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="13" />
            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>