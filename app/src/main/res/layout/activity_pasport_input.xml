<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <Button
        android:id="@+id/btn_to_home"
        android:layout_width="114dp"
        android:layout_height="62dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="На главный"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/btn_to_input_data"
        android:layout_width="226dp"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:text="ввод данных для расчёта"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.797"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints" />

    <ScrollView
        android:layout_width="370dp"
        android:layout_height="480dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/textPsportDat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Паспортные данные объекта" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pWorkerName"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Техник" />
                <EditText
                    android:id="@+id/edWorkerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Сергей Волков" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pDate"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Дата замера" />
                <EditText
                    android:id="@+id/edDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="01.01.2026" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pObjName"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Объект" />
                <EditText
                    android:id="@+id/edObjName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="Горчаково" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pObjNumber"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Заводской №" />
                <EditText
                    android:id="@+id/edObjNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="10007" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pTypeCompetition"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Исполнение" />
                <EditText
                    android:id="@+id/edTypeCompetition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pYearMade"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Год выпуска" />
                <EditText
                    android:id="@+id/edYearMade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="2010" />
            </LinearLayout>

            <TextView
                android:id="@+id/textHeathGen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Теплогенератор" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pType"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Тип" />
                <EditText
                    android:id="@+id/edType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="газ" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pGenNumber"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Заводской номер" />
                <EditText
                    android:id="@+id/edGenNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1337" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pMadedBy"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Изготовитель" />
                <EditText
                    android:id="@+id/edMadedBy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="ОАО ОЛЕГ" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pCodeName"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Обозначение" />
                <EditText
                    android:id="@+id/edCodeName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="оукалыов" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pGenYearOfMade"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Год выпуска" />
                <EditText
                    android:id="@+id/edGenYearOfMade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="2015" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pGenPower"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Мощность" />
                <EditText
                    android:id="@+id/edGenPower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1320000" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pDiamertBurn"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Диаметр камеры сгорания мм" />
                <EditText
                    android:id="@+id/edDiamertBurn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="5000" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pLenBurn"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Длина камеры мм" />
                <EditText
                    android:id="@+id/edLenBurn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="2000" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pTypeBurn"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Тип камеры" />
                <EditText
                    android:id="@+id/edTypeBurn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="42Type" />
            </LinearLayout>
            <TextView
                android:id="@+id/textPressureRelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Реле давления                                 тип / значение" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pLgw"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="LGW[мБар]" />

                <EditText
                    android:id="@+id/edLgwType"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="97dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="/" />

                <EditText
                    android:id="@+id/edLgwValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pGasMin"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="газ мин.[мБар]" />

                <EditText
                    android:id="@+id/edGasMinType"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />

                <TextView
                    android:id="@+id/textgasmin"
                    android:layout_width="97dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="/" />

                <EditText
                    android:id="@+id/edGasMinValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pGasMax"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="газ макс.[мБар]" />

                <EditText
                    android:id="@+id/edGasMaxType"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />

                <TextView
                    android:id="@+id/textgasmax"
                    android:layout_width="97dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="/" />

                <EditText
                    android:id="@+id/edGasMaxValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pContrGerm"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="контр. герм.[мБар]" />

                <EditText
                    android:id="@+id/edContrGermType"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />

                <TextView
                    android:id="@+id/textcontrgerm"
                    android:layout_width="97dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="/" />

                <EditText
                    android:id="@+id/edContrGermValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pPsk"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="ПСК[мБар]" />

                <EditText
                    android:id="@+id/edPskType"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />

                <TextView
                    android:id="@+id/textpsk"
                    android:layout_width="97dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="/" />

                <EditText
                    android:id="@+id/edPskValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pPzk"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="ПЗК[мБар]" />

                <EditText
                    android:id="@+id/edPzkType"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />

                <TextView
                    android:id="@+id/textpzk"
                    android:layout_width="97dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="/" />

                <EditText
                    android:id="@+id/edPzkValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ems="10"
                    android:inputType="text"
                    android:text="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pControlGermArm"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="Контроль Герметичности Арматуры" />
                <EditText
                    android:id="@+id/edControlGermArm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text="ЛОВЫПИЫВЛПР" />
            </LinearLayout>



        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>